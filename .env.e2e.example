# Entorno E2E LOCAL (aislado). Se copia a `.env.e2e` (gitignoreado) en `pnpm e2e:up` si no existe.
# NUNCA apuntar a Supabase ni al Postgres nativo: scripts/e2e/env.ts aborta si ve `supabase`/`pooler`
# o un host que no sea localhost/127.0.0.1. Este archivo no contiene secretos reales.
# Las claves RSA (JWT_PRIVATE_KEY/JWT_PUBLIC_KEY) NO van acá: se generan en cada corrida.

PROJECT_NAME=TekoApp-E2E
PROJECT_DESCRIPTION="Entorno E2E local"
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=develop
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3001
WEB_CLIENT_SECRET=e2e-web-secret
MOBILE_CLIENT_SECRET=e2e-mobile-secret
SEQ_ENABLED=false
SEQ_URL=http://localhost:5341
GLITCHTIP_DSN=

# Se ignora si NODE_ENV=production
RATE_LIMIT_MULTIPLIER=1000

DATABASE_URL="postgresql://postgres:postgres@localhost:55432/tekoapp_e2e?schema=public"
DATABASE_CONNECTION_STRING="postgresql://postgres:postgres@localhost:55432/tekoapp_e2e?schema=public"
AUDIT_SECRET_PEPPER=e2e-pepper-not-secret
MONGODB_URI=mongodb://localhost:57017/tekoapp_e2e
MONGODB_MAX_POOL_SIZE=5
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=
REDIS_DB=0

ACCESS_TOKEN_EXPIRES=15m
TEMP_TOKEN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=7d
REFRESH_TOKEN_SHORT_EXPIRES=12h
PASSWORD_EXPIRATION_DAYS=0
PASSWORD_HISTORY_LIMIT=5

# Email -> MailHog (UI: http://localhost:58025)
EMAIL_HOST=localhost
EMAIL_PORT=51025
EMAIL_USER=e2e
EMAIL_PASSWORD=e2e
EMAIL_DIR=e2e@tekoapp.local

# Storage -> MinIO
S3_ACCESS_KEY_ID=e2e-minio-user
S3_SECRET_ACCESS_KEY=e2e-minio-password
S3_BUCKET_NAME=tekoapp-e2e-uploads
S3_REGION=us-east-1
S3_MAX_CONCURRENCY=5
S3_RETRY_ATTEMPTS=3
S3_RETRY_DELAY_MS=250
S3_PRESIGNED_URL_EXPIRES_IN=900
S3_ENDPOINT=http://localhost:59000
S3_FORCE_PATH_STYLE=true

GOOGLE_MAPS_API_KEY=e2e-stub
DEFAULT_RADIUS_KM=10
MAX_RADIUS_KM=50

# FCM stub: credenciales inválidas => FcmProviderService degrada a "FCM deshabilitado" sin tumbar el boot
FIREBASE_PROJECT_ID=e2e-stub
FIREBASE_PRIVATE_KEY=e2e-stub
FIREBASE_CLIENT_EMAIL=e2e-stub@example.invalid
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: se generan en cada corrida (web-push exige claves validas)
VAPID_SUBJECT=mailto:e2e@tekoapp.local

# Solo claves de TEST/stub (nunca sk_live)
STRIPE_SECRET_KEY=sk_test_e2e_stub
STRIPE_WEBHOOK_SECRET=whsec_e2e_stub
PAYMENT_CURRENCY=PYG
PAYMENT_MIN_AMOUNT=10000
PAYMENT_MAX_AMOUNT=1000000

# Twilio stub
TWILIO_ACCOUNT_SID=ACe2estub
TWILIO_AUTH_TOKEN=e2e-stub
TWILIO_PHONE_NUMBER=+15005550006
