  description String?          @db.Text
  percentage  Decimal          @default(0.0000) @db.Decimal(6, 4)
  fixedAmount Decimal          @default(0.00) @map("fixed_amount") @db.Decimal(10, 2)
  minimumFee  Decimal?         @map("minimum_fee") @db.Decimal(10, 2)
  maximumFee  Decimal?         @map("maximum_fee") @db.Decimal(10, 2)
  target      CommissionTarget @default(ALL)
  targetId    String?          @map("target_id") @db.VarChar(50)
  isDefault   Boolean          @default(false) @map("is_default")
  isActive    Boolean          @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  @@index([isDefault, isActive])
  @@map("platform_commission_config")
}

// =====================================================================================================================
// PROTECCIÓN DE DATOS, IMÁGENES Y SU USO (Fase 0006 — ver openspec/specs/data-and-media-consent.md)
// =====================================================================================================================

enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  DATA_PROCESSING_CONSENT
  IMAGE_USAGE_CONSENT
  SERVICE_CONTRACT_TERMS
  // Backlog post-Fase 0004, punto 5 (2026-08-28): "deslinde de responsabilidad por contenido de
  // usuario". Reusa toda la infraestructura genérica ya existente (LegalDocumentVersions +
  // UserConsents + RequiresActiveConsentGuard) — solo se agrega el tipo, staff carga la versión
  // real vía el admin de Web cuando legal provea el texto. No se gatea ninguna ruta con esto
  // todavía (decidir qué acción de contenido de usuario lo exige es un producto/legal call, no
  // técnico — ver openspec/decisions.md).
  USER_CONTENT_LIABILITY_DISCLAIMER
}

enum ContentUsageScope {
  APP_INTERNAL_ONLY
  PUBLIC_PROFILE_DISPLAY
  MARKETING
}

/// Introducido acá (Fase 0006) en vez de en la Fase 0005 (ai-content-disclosure.md, que es donde
/// "pertenece" conceptualmente) porque `ContentConsentGrants`/`DataRetentionPolicies` ya lo
/// necesitan como tipo de columna y los enums de Postgres deben existir antes de usarse. La Fase
/// 0005 reusa este mismo enum al agregar `AiContentDisclosures` — no se duplica.
enum AiDisclosureEntityType {
  SERVICE_DESCRIPTION
  BUDGET_OPTION
  PROGRESS_NOTE
  PROFESSIONAL_DESCRIPTION
  IMAGE
  OTHER // catch-all extensible sin migración para tipos de contenido que todavía no existen
}

/// Catálogo versionado, editable sin deploy por staff.
model LegalDocumentVersions {
  id           Int               @id @default(autoincrement())
  referenceId  String            @unique @default(uuid()) @map("reference_id")
  documentType LegalDocumentType @map("document_type")
  countryId    Int?              @map("country_id") // null = versión internacional/paraguas
  version      String            @db.VarChar(20)
  contentUrl   String            @map("content_url") @db.VarChar(500)
  publishedAt  DateTime          @map("published_at")
  isActive     Boolean           @default(true) @map("is_active")

  country   Country?       @relation(fields: [countryId], references: [id])
  consents  UserConsents[]
  contracts Contracts[]

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")

  @@index([documentType, countryId, isActive])
  @@map("legal_document_versions")
}

model UserConsents {
  id                     Int      @id @default(autoincrement())
  referenceId            String   @unique @default(uuid()) @map("reference_id")
  userId                 Int      @map("user_id")
  legalDocumentVersionId Int      @map("legal_document_version_id")
  acceptedAt             DateTime @default(now()) @map("accepted_at")
  ipAddress              String?  @map("ip_address") @db.VarChar(45)
  userAgent              String?  @map("user_agent") @db.VarChar(255)
  acceptanceHash         String   @map("acceptance_hash") @db.VarChar(128)

  user                 Users                 @relation(fields: [userId], references: [id])
  legalDocumentVersion LegalDocumentVersions @relation(fields: [legalDocumentVersionId], references: [id])

  @@unique([userId, legalDocumentVersionId])
  @@map("user_consents")
}

/// Consentimiento de USO por contenido puntual — más fino que la aceptación general de ToS. No
/// tiene `@@unique` sobre (contentType, contentReferenceId): revocar y volver a otorgar crea una
/// fila nueva (historial completo), la fila "vigente" es la que tiene `revokedAt: null`.
model ContentConsentGrants {
  id                 Int                    @id @default(autoincrement())
  referenceId        String                 @unique @default(uuid()) @map("reference_id")
  contentType        AiDisclosureEntityType @map("content_type")
  contentReferenceId String                 @map("content_reference_id")
  uploaderUserId     Int                    @map("uploader_user_id")
  usageScope         ContentUsageScope      @default(APP_INTERNAL_ONLY) @map("usage_scope")
  grantedAt          DateTime               @default(now()) @map("granted_at")
  revokedAt          DateTime?              @map("revoked_at")

  uploader Users @relation(fields: [uploaderUserId], references: [id])

  @@index([contentType, contentReferenceId])
  @@map("content_consent_grants")
}

/// Cuánto tiempo se retiene cada tipo de contenido y si el usuario puede pedir su baja.
model DataRetentionPolicies {
  id                 Int                    @id @default(autoincrement())
  referenceId        String                 @unique @default(uuid()) @map("reference_id")
  countryId          Int?                   @map("country_id")
  contentType        AiDisclosureEntityType @map("content_type")
  retentionDays      Int?                   @map("retention_days")
  allowsUserDeletion Boolean                @default(true) @map("allows_user_deletion")
  requiresLegalHold  Boolean                @default(false) @map("requires_legal_hold")

  country Country? @relation(fields: [countryId], references: [id])

  @@unique([countryId, contentType])
  @@map("data_retention_policies")
}

enum AiDisclosureSource {
  PLATFORM_AI // generado por una feature de IA de la propia plataforma
  USER_DECLARED_AI // el usuario marcó voluntariamente su contenido como asistido por IA
}

/// Tabla polimórfica deliberada — `entityReferenceId` no es una FK real de Postgres (apunta al
/// `referenceId` de cualquier tabla futura), para no requerir una migración por cada tipo de
/// contenido nuevo que empiece a soportar disclosure. Ver `openspec/specs/ai-content-disclosure.md`.
model AiContentDisclosures {
  id                Int                    @id @default(autoincrement())
  referenceId       String                 @unique @default(uuid()) @map("reference_id")
  entityType        AiDisclosureEntityType @map("entity_type")
  entityReferenceId String                 @map("entity_reference_id")
  source            AiDisclosureSource
  aiProvider        String?                @map("ai_provider") @db.VarChar(60)
  declaredByUserId  Int?                   @map("declared_by_user_id")
  note              String?                @db.Text

  declaredByUser Users? @relation(fields: [declaredByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([entityType, entityReferenceId])
  @@map("ai_content_disclosures")
}

enum MaterialQualityTier {
  BASIC
  STANDARD
  PREMIUM
}

enum BudgetLineItemType {
  MATERIAL
  LABOR
  OTHER
}

/// Catálogo parametrizable de materiales/calidades por categoría de servicio y país — precio
/// SUGERIDO para el profesional al armar un presupuesto, no un precio regulado/fijo (ver
/// openspec/specs/multi-option-quotes.md).
model MaterialCatalog {
  id           Int                 @id @default(autoincrement())
  referenceId  String              @unique @default(uuid()) @map("reference_id")
  categoryId   Int                 @map("category_id")
  countryId    Int?                @map("country_id") // null = aplica a todos los países
  name         String              @db.VarChar(150)
  unit         String              @db.VarChar(30)
  qualityTier  MaterialQualityTier @map("quality_tier")
  defaultPrice Decimal             @map("default_price") @db.Decimal(10, 2)
  isActive     Boolean             @default(true) @map("is_active")

  category  Category          @relation(fields: [categoryId], references: [id])
  country   Country?          @relation(fields: [countryId], references: [id])
  lineItems BudgetLineItems[]

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")

  @@index([categoryId, countryId, isActive])
  @@map("material_catalog")
}

/// Una opción de presupuesto alternativa sobre una ServiceRequests (propuesta de un profesional) —
/// ver openspec/specs/multi-option-quotes.md. `totalPrice`/`estimatedHours` SIEMPRE se recalculan
/// server-side a partir de los line items, nunca se confía en lo que manda el cliente.
model BudgetOptions {
  id               Int      @id @default(autoincrement())
  referenceId      String   @unique @default(uuid()) @map("reference_id")
  serviceRequestId Int      @map("service_request_id")
  label            String   @db.VarChar(100)
  description      String?  @db.Text
  totalPrice       Decimal  @map("total_price") @db.Decimal(10, 2)
  estimatedHours   Decimal? @map("estimated_hours") @db.Decimal(10, 2)
  isSelected       Boolean  @default(false) @map("is_selected")

  serviceRequest ServiceRequests   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  lineItems      BudgetLineItems[]
  contract       Contracts?

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  // Montos financieros reales (presupuesto de un profesional) — mismo criterio que
  // ServiceRequests/Payments, califica para `fn_attach_audit_triggers()`. A diferencia de
  // MaterialCatalog (catálogo de configuración, sin estos campos a propósito).
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  @@index([serviceRequestId])
  @@map("budget_options")
}

/// Ítem de línea de una BudgetOptions — de catálogo (`catalogItemId`) o libre (`catalogItemId:
/// null`). `subtotal` se recalcula server-side (`quantity * unitPrice`), nunca se confía en el
/// valor que manda el cliente.
model BudgetLineItems {
  id             Int                @id @default(autoincrement())
  referenceId    String             @unique @default(uuid()) @map("reference_id")
  budgetOptionId Int                @map("budget_option_id")
  itemType       BudgetLineItemType @map("item_type")
  catalogItemId  Int?               @map("catalog_item_id")
  description    String             @db.VarChar(255)
  quantity       Decimal            @db.Decimal(10, 2)
  unitPrice      Decimal            @map("unit_price") @db.Decimal(10, 2)
  subtotal       Decimal            @db.Decimal(10, 2)

  budgetOption BudgetOptions    @relation(fields: [budgetOptionId], references: [id], onDelete: Cascade)
  catalogItem  MaterialCatalog? @relation(fields: [catalogItemId], references: [id])

  @@index([budgetOptionId])
  @@map("budget_line_items")
}

enum ContractStatus {
  DRAFT
  PENDING_CLIENT_SIGNATURE
  PENDING_PROFESSIONAL_SIGNATURE
  SIGNED
  CANCELLED
}

/// Contrato cliente↔profesional generado a partir de una `BudgetOptions` seleccionada — ver
/// openspec/specs/service-contracts.md. El mecanismo de firma es un "clickwrap" reforzado (nombre
/// tipeado + checkbox + hash del contenido + timestamp), NO una firma digital calificada
/// (eIDAS/FIDO/PKI) — ver "Riesgos / límites explícitos" del spec.
model Contracts {
  id             Int            @id @default(autoincrement())
  referenceId    String         @unique @default(uuid()) @map("reference_id")
  serviceId      Int            @map("service_id")
  budgetOptionId Int            @unique @map("budget_option_id")
  clientUserId   Int            @map("client_user_id")
  professionalId Int            @map("professional_id")
  status         ContractStatus @default(DRAFT)

  /// Snapshot inmutable al momento de generar el contrato — nunca se relee BudgetOptions en vivo
  /// después de creado (ver "Riesgos" del spec: cambios posteriores a BudgetOptions/Category no
  /// afectan un contrato ya generado, es el comportamiento esperado).
  contentSnapshot Json @map("content_snapshot") @db.JsonB

  /// Hoy siempre resuelve a la versión `countryId: null` (paraguas) del tipo
  /// `SERVICE_CONTRACT_TERMS` — mismo límite ya documentado en
  /// `LegalConsentsDbService.findPendingVersionsForUser` (el negocio es Paraguay-only, no hay
  /// país por Service/User todavía). Nullable: no bloquea la generación si no existe ninguna
  /// versión publicada todavía.
  legalTermsVersionId Int? @map("legal_terms_version_id")

  clientSignedAt            DateTime? @map("client_signed_at")
  clientSignatureName       String?   @map("client_signature_name")
  clientSignatureHash       String?   @map("client_signature_hash")
  professionalSignedAt      DateTime? @map("professional_signed_at")
  professionalSignatureName String?   @map("professional_signature_name")
  professionalSignatureHash String?   @map("professional_signature_hash")

  /// Key de S3 del PDF — se genera recién cuando `status` pasa a `SIGNED` (ver
  /// `ContractsService.signContract`), nunca antes.
  pdfKey String? @map("pdf_key")

  service           Services               @relation(fields: [serviceId], references: [id])
  budgetOption      BudgetOptions          @relation(fields: [budgetOptionId], references: [id])
  client            Users                  @relation(fields: [clientUserId], references: [id])
  professional      Professionals          @relation(fields: [professionalId], references: [id])
  legalTermsVersion LegalDocumentVersions? @relation(fields: [legalTermsVersionId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  // Registro legal/financiero (contenido de un presupuesto aceptado + evidencia de firma) —
  // mismo criterio que BudgetOptions, califica para `fn_attach_audit_triggers()`.
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  @@index([serviceId])
  @@index([clientUserId])
  @@index([professionalId])
  @@map("contracts")
}
