generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLogs {
  id            BigInt   @id @default(autoincrement())
  tableName     String   @map("table_name")
  recordId      String   @map("record_id")
  operationType String   @map("operation_type")
  oldData       Json?    @map("old_data")
  newData       Json?    @map("new_data")
  changedAt     DateTime @default(now()) @map("changed_at")
  changedBy     String   @map("changed_by")

  reason          String? @map("reason")
  ipAddress       String? @map("ip_address")
  userAgent       String? @map("user_agent")
  extraData       String? @map("extra_data")
  audVersion      Int?    @map("aud_version")
  changeSignature String? @map("change_signature")

  @@index([changedAt(sort: Desc)], name: "idx_audit_changed_at")
  @@index([changedBy], name: "idx_audit_changed_by")
  @@index([tableName, recordId], name: "idx_audit_table_record")
  @@map("audit_logs")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
  INACTIVE
  REFUSED
  PENDING_VERIFICATION
}

enum UserProfileStatus {
  INCOMPLETE
  COMPLETE
  DOCUMENT_PENDING
}

model AccessLevel {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  users Users[]

  @@map("access_level")
}

model Users {
  id                  Int               @id @default(autoincrement())
  referenceId         String            @unique @default(uuid()) @map("reference_id")
  email               String            @unique @map("email")
  status              UserStatus        @default(ACTIVE) @map("status")
  profileStatus       UserProfileStatus @default(INCOMPLETE) @map("profile_status")
  lastLogin           DateTime?         @map("last_login")
  firstName           String            @map("first_name")
  lastName            String            @map("last_name")
  documentTypeId      Int               @map("document_type_id")
  documentNumber      String?           @map("document_number")
  phoneNumber         String?           @map("phone_number")
  // Foto de perfil: guarda la KEY de S3 (permanente), no una URL — las URLs que devuelve
  // `POST /uploads/avatar` son presignadas y expiran en 900s (`S3_PRESIGNED_URL_EXPIRES_IN`).
  // Cada response que expone esto al cliente resuelve una URL presignada fresca a partir de la
  // key en el momento de la lectura (ver `UploadsService.getPresignedUrl()`), nunca sirve una URL
  // vieja guardada. Nullable: sin foto se muestra un fallback de iniciales.
  avatarKey           String?           @map("avatar_key")
  isEmployee          Boolean           @default(false) @map("is_employee")
  isLdap              Boolean           @default(false) @map("ldap")
  createdAt           DateTime          @default(now()) @map("created_at")
  createdBy           String            @map("created_by")
  lastChangedAt       DateTime?         @default(now()) @map("last_changed_at")
  lastChangedBy       String?           @map("last_changed_by")
  unverifiedEmail     String?           @map("unverified_email")
  changedReason       String?           @map("changed_reason")
  acceptedTermsAt     DateTime?         @map("accepted_terms_at")
  accessLevelId       Int?              @map("access_level_id")
  // Idioma preferido del usuario. Nullable: sin preferencia explícita => se usa el default `es`
  // del sistema (ver catálogo `languages`). No cambia comportamiento hoy (negocio Paraguay-only).
  preferredLanguageId Int?              @map("preferred_language_id")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  roles                 UserRoles[]
  permissions           UserPermissions[]
  credentials           UserCredentials[]
  professionals         Professionals?
  services              Services[]
  documentTypes         DocumentsType          @relation(fields: [documentTypeId], references: [id])
  accessLevel           AccessLevel?           @relation(fields: [accessLevelId], references: [id])
  preferredLanguage     Language?              @relation(fields: [preferredLanguageId], references: [id])
  payments              Payments[]
  paymentMethodEntities PaymentMethodEntity[]
  ratings               Rating[]
  promotionUsages       PromotionUsage[]
  pushSubscriptions     PushSubscriptions[]
  fcmTokens             FcmTokens[]
  legalConsents         UserConsents[]
  contentConsentGrants  ContentConsentGrants[]
  aiContentDisclosures  AiContentDisclosures[]
  contracts             Contracts[]
  tips                  Tips[]

  @@unique([documentTypeId, documentNumber, email], name: "UK_users_document")
  @@map("users")
}

model DocumentsType {
  id   Int    @id @default(autoincrement())
  name String @map("nombre")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")
  users           Users[]

  @@map("documents_type")
}

model UserRoles {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  roleId Int @map("role_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Roles @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Roles {
  id          Int     @id @default(autoincrement())
  referenceId String  @unique @default(uuid()) @map("reference_id")
  name        String  @unique @map("name")
  description String? @map("description")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  displayName String? @map("display_name")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  rolePermissions RolePermissions[]
  userRoles       UserRoles[]

  @@index([isActive])
  @@map("roles")
}

model Permissions {
  id          Int     @id @default(autoincrement())
  name        String  @unique @map("name")
  description String? @map("description")

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String    @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  displayName String? @map("display_name")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  rolePermissions RolePermissions[]
  userPermissions UserPermissions[]

  @@index([name])
  @@index([isActive])
  @@map("permissions")
}

model RolePermissions {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissions {
  id           Int @id @default(autoincrement())
  userId       Int @map("user_id")
  permissionId Int @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")

  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  user       Users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

model UserCredentials {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiredAt    DateTime? @map("expired_at")
  attempts     Int       @default(0) @map("attempts")

  lastChangedAt   DateTime? @map("last_changed_at")
  createdBy       String?   @map("created_by")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_credentials")
}

model ApiClientCredential {
  id            Int       @id @default(autoincrement())
  clientId      String    @unique @map("client_id")
  clientName    String?   @map("client_name")
  secretKey     String    @map("secret_key")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastChangedAt DateTime? @map("last_changed_at")
  createdBy     String?   @map("created_by")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")

  checksum        String? @map("checksum")
  changeSignature String? @map("change_signature")

  @@map("api_client_credential")
}

// =====================================================================================================================
// MODELOS ESPECÍFICOS DE TEKOAPP (MIGRADOS DESDE EL MODELO RELACIONAL)
// =====================================================================================================================

enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model ServiceType {
  id   Int    @id @default(autoincrement())
  name String @unique @map("name")

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  services Services[]

  @@map("service_type")
}

enum ServiceStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Professionals {
  id                Int                @id @default(autoincrement())
  referenceId       String             @unique @default(uuid()) @map("reference_id")
  userId            Int                @unique @map("user_id") // Relación 1:1 con tu tabla Users
  categoryId        Int                @map("category_id")
  description       String             @db.Text
  hourlyRate        Decimal            @map("hourly_rate") @db.Decimal(10, 2)
  fixedRate         Decimal?           @map("fixed_rate") @db.Decimal(10, 2)
  skills            String[]           @default([])
  certifications    String[]           @default([])
  yearsOfExperience Int                @default(0) @map("years_of_experience")
  status            ProfessionalStatus @default(PENDING)
  isAvailable       Boolean            @default(false) @map("is_available")
  isOnline          Boolean            @default(false) @map("is_online")

  // Aprobación manual de staff sobre la cuenta del profesional (onboarding) — "verified"/
  // "rejected" seteado junto con `status` desde `ProfessionalsService.verifyProfessional()`.
  // Campo legacy, NO tocar desde la Fase 0001 de documentos/antecedentes (ver
  // `requiredDocumentsVerified` abajo y openspec/decisions.md — colisión encontrada y corregida).
  verificationStatus String @default("unverified") @map("verification_status") @db.VarChar(20) // e.g., verified

  // Derivado automáticamente por `ProfessionalVerificationHelper.recompute()` — true cuando TODOS
  // los `ProfessionalDocumentTypes` obligatorios aplicables a la categoría del profesional tienen
  // un `ProfessionalDocuments` APPROVED y sin vencer. Campo separado de `verificationStatus` a
  // propósito: son 2 conceptos distintos con 2 escritores distintos (aprobación manual de cuenta
  // vs. estado automático de documentos), compartir el mismo campo los pisaría entre sí.
  requiredDocumentsVerified Boolean @default(false) @map("required_documents_verified")

  // Última posición conocida (El histórico pesado va a Mongo)
  currentLatitude    Decimal?  @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude   Decimal?  @map("current_longitude") @db.Decimal(10, 7)
  lastLocationUpdate DateTime? @map("last_location_update")

  totalServices Int     @default(0) @map("total_services")
  averageRating Decimal @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalRatings  Int     @default(0) @map("total_ratings")

  // Seguridad de datos que manejas en tu starter
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  // Relaciones
  user                  Users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category              Category                 @relation(fields: [categoryId], references: [id])
  services              Services[]
  serviceRequests       ServiceRequests[]
  payments              Payments[]
  ratings               Rating[]
  progressEntries       ServiceProgressEntries[]
  professionalDocuments ProfessionalDocuments[]
  contracts             Contracts[]
  tips                  Tips[]
  portfolioItems        ProfessionalPortfolioItems[]

  @@index([status])
  @@index([isAvailable])
  @@map("professionals")
}

model Services {
  id             Int           @id @default(autoincrement())
  referenceId    String        @unique @default(uuid()) @map("reference_id") // Id público (UUID) expuesto por la API
  userId         Int           @map("user_id")
  professionalId Int?          @map("professional_id")
  categoryId     Int           @map("category_id")
  title          String        @db.VarChar(255)
  description    String        @db.Text
  serviceTypeId  Int           @map("service_type_id")
  status         ServiceStatus @default(PENDING)
  estimatedHours Decimal?      @map("estimated_hours") @db.Decimal(10, 2)
  actualHours    Decimal?      @map("actual_hours") @db.Decimal(10, 2)
  hourlyRate     Decimal?      @map("hourly_rate") @db.Decimal(10, 2)
  fixedPrice     Decimal?      @map("fixed_price") @db.Decimal(10, 2)
  totalAmount    Decimal?      @map("total_amount") @db.Decimal(10, 2) // Monto inicial
  finalAmount    Decimal?      @map("final_amount") @db.Decimal(10, 2) // Monto final tras horas reales

  // Ubicación del servicio
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  address         String   @db.VarChar(255)
  additionalNotes String?  @db.Text
  images          String[] @default([])
  isUrgent        Boolean  @default(false) @map("is_urgent")

  // Tiempos
  scheduledAt        DateTime? @map("scheduled_at")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason") @db.Text

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  // Relaciones
  professional Professionals? @relation(fields: [professionalId], references: [id])
  serviceType  ServiceType    @relation(fields: [serviceTypeId], references: [id])

  requests ServiceRequests[]
  payments Payments[]
  ratings  Rating[]
  users    Users?            @relation(fields: [userId], references: [id])
  category Category          @relation(fields: [categoryId], references: [id])

  progressEntries ServiceProgressEntries[]
  contracts       Contracts[]

  @@index([status])
  @@index([userId])
  @@index([professionalId])
  @@map("services")
}

model ServiceProgressEntries {
  id             Int      @id @default(autoincrement())
  referenceId    String   @unique @default(uuid()) @map("reference_id")
  serviceId      Int      @map("service_id")
  professionalId Int      @map("professional_id")
  note           String?  @db.Text
  images         String[] @default([]) // S3 keys, mismo patrón que Services.images
  entryOrder     Int      @map("entry_order") // secuencia dentro del service, para ordenar sin depender solo de createdAt

  service      Services      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional Professionals @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")
  isActive      Boolean   @default(true) @map("is_active") // "borrado" = isActive:false dentro de la ventana de corrección

  @@index([serviceId, entryOrder])
  @@map("service_progress_entries")
}

enum DocumentCategory {
  BACKGROUND_CHECK // antecedentes policiales/judiciales
  QUALIFICATION // títulos, certificados
  PORTFOLIO // evidencia de trabajos previos
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Catálogo parametrizable de documentos de habilitación/antecedente del PROFESIONAL en su rol de
/// tal (título técnico, certificado, antecedentes policiales/judiciales) — no confundir con
/// `DocumentsType` (documento de IDENTIDAD de la persona: Cédula/DNI/Pasaporte, usado por
/// `Users.documentTypeId`), concepto de negocio completamente distinto. Ver
/// openspec/decisions.md, "Fase 0001 — rename DocumentTypes → ProfessionalDocumentTypes".
/// countryId/professionalCategoryId NULL = aplica globalmente (sin scoping).
model ProfessionalDocumentTypes {
  id                     Int              @id @default(autoincrement())
  referenceId            String           @unique @default(uuid()) @map("reference_id")
  code                   String           @unique @db.VarChar(60) // ej. "BG_CHECK_CRIMINAL_PY"
  name                   String           @db.VarChar(150)
  description            String?          @db.Text
  category               DocumentCategory
  countryId              Int?             @map("country_id")
  professionalCategoryId Int?             @map("professional_category_id")
  isRequired             Boolean          @default(false) @map("is_required")
  validityDays           Int?             @map("validity_days") // null = no vence
  requiresStaffReview    Boolean          @default(true) @map("requires_staff_review")
  isVisibleToClient      Boolean          @default(false) @map("is_visible_to_client")
  sortOrder              Int              @default(0) @map("sort_order")
  isActive               Boolean          @default(true) @map("is_active")

  country              Country?                @relation(fields: [countryId], references: [id])
  professionalCategory Category?               @relation(fields: [professionalCategoryId], references: [id])
  documents            ProfessionalDocuments[]

  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  lastChangedAt DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy String?   @map("last_changed_by")
  changedReason String?   @map("changed_reason")

  @@index([category])
  @@map("professional_document_types")
}

model ProfessionalDocuments {
  id                         Int                  @id @default(autoincrement())
  referenceId                String               @unique @default(uuid()) @map("reference_id")
  professionalId             Int                  @map("professional_id")
  professionalDocumentTypeId Int                  @map("professional_document_type_id")
  fileKey                    String               @map("file_key") // S3 key, mismo patrón que Users.avatarKey
  status                     DocumentReviewStatus @default(PENDING)
  issuedAt                   DateTime?            @map("issued_at")
  expiresAt                  DateTime?            @map("expires_at")
  reviewedAt                 DateTime?            @map("reviewed_at")
  reviewedBy                 String?              @map("reviewed_by") // referenceId del usuario staff
  rejectionReason            String?              @map("rejection_reason") @db.Text
  metadata                   Json?                @db.JsonB

  professional             Professionals             @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalDocumentType ProfessionalDocumentTypes @relation(fields: [professionalDocumentTypeId], references: [id])

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  @@index([professionalId, status])
  @@map("professional_documents")
}

enum PortfolioReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Galería de fotos de trabajos previos del profesional (evidencia de calidad/experiencia,
/// visible en su perfil público) — NO confundir con `ProfessionalDocuments` (documentos de
/// compliance: antecedentes, títulos). Reemplaza la idea original de `DocumentCategory.PORTFOLIO`
/// (un documento único más, reusando el catálogo de compliance) — José confirmó 2026-09-02 que
/// esto sí necesita revisión de staff antes de publicarse, igual que los documentos de compliance,
/// pero es un modelo aparte porque no hay catálogo de "tipos" ni scoping por país/categoría: un
/// profesional puede subir tantas fotos como quiera, cada una con su propia aprobación individual.
model ProfessionalPortfolioItems {
  id              Int                   @id @default(autoincrement())
  referenceId     String                @unique @default(uuid()) @map("reference_id")
  professionalId  Int                   @map("professional_id")
  fileKey         String                @map("file_key") // S3 key, mismo patrón que ProfessionalDocuments.fileKey
  caption         String?               @db.Text
  sortOrder       Int                   @default(0) @map("sort_order")
  isVisible       Boolean               @default(true) @map("is_visible") // ocultado reactivo por el propio profesional, independiente de `status`
  status          PortfolioReviewStatus @default(PENDING)
  reviewedAt      DateTime?             @map("reviewed_at")
  reviewedBy      String?               @map("reviewed_by") // referenceId del usuario staff
  rejectionReason String?               @map("rejection_reason") @db.Text

  professional Professionals @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  isActive        Boolean   @default(true) @map("is_active")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  @@index([professionalId, status])
  @@map("professional_portfolio_items")
}

model ServiceRequests {
  id             Int           @id @default(autoincrement())
  referenceId    String        @unique @default(uuid()) @map("reference_id")
  serviceId      Int           @map("service_id")
  professionalId Int           @map("professional_id")
  status         RequestStatus @default(PENDING)
  proposedPrice  Decimal?      @map("proposed_price") @db.Decimal(10, 2)
  proposedHours  Decimal?      @map("proposed_hours") @db.Decimal(10, 2)
