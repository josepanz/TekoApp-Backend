// =====================================================================================================================
// PROPINAS — entidad separada de `Payments`, nunca fusionada al monto del pago ni al cálculo de
// comisión (`fee-calculator.service.ts`) — es 100% para el profesional. Ver
// openspec/changes/0010-tips.md.
// =====================================================================================================================

enum TipMode {
  PERCENTAGE
  FIXED
  FREE
}

// Configuración parametrizable de propinas — mismo criterio de resolución por país que
// `LegalDocumentVersions` (`countryId: null` = default global, sin país por Service/User todavía
// así que hoy solo se resuelve el default global — ver decisions.md). Sin `@@unique([countryId])`
// a propósito: mismo patrón que `PlatformCommissionConfig` (múltiples filas posibles, se resuelve
// la más reciente activa en vez de forzar unicidad a nivel de DB).
model TipConfig {
  id                   Int     @id @default(autoincrement())
  countryId            Int?    @map("country_id")
  isEnabled            Boolean @default(true) @map("is_enabled")
  isMandatory          Boolean @default(false) @map("is_mandatory")
  suggestedPercentages Json    @default("[10, 15, 20]") @map("suggested_percentages")
  allowFreeAmount      Boolean @default(true) @map("allow_free_amount")
  isActive             Boolean @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  country Country? @relation(fields: [countryId], references: [id])

  @@index([countryId, isActive])
  @@map("tip_config")
}

// Backlog post-Fase 0004, punto 5 (2026-08-28): "protocolo de IVA por país" — mismo criterio de
// resolución por país que TipConfig/LegalDocumentVersions (`countryId: null` = default global,
// sin país resuelto por Service/User todavía). Deliberadamente NO se computa/wirea todavía en
// `PaymentApiService.createPayment` — las tasas reales deben venir de asesoría fiscal real, no de
// inferencia de este LLM (ver openspec/decisions.md). Sin CRUD admin en Web todavía, mismo alcance
// mínimo que PlatformCommissionConfig/TipConfig (carga por DB directa hasta que exista una
// necesidad real de UI).
model TaxConfig {
  id        Int     @id @default(autoincrement())
  countryId Int?    @map("country_id")
  name      String  @db.VarChar(100)
  rate      Decimal @default(0.0000) @db.Decimal(6, 4)
  isEnabled Boolean @default(false) @map("is_enabled")
  isActive  Boolean @default(true) @map("is_active")

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  country Country? @relation(fields: [countryId], references: [id])

  @@index([countryId, isActive])
  @@map("tax_config")
}

// Una propina por pago (`paymentId` único) — `userId`/`professionalId` denormalizados desde el
// `Payment` para queries directas sin join. `percentage` solo se completa si `mode=PERCENTAGE`;
// `amount` siempre queda poblado con el monto final (calculado server-side si es porcentaje,
// provisto por el cliente si es `FIXED`/`FREE` — la distinción entre esos dos modos es de UI/
// analítica, ambos mandan un monto final directo, ver decisions.md).
model Tips {
  id             Int      @id @default(autoincrement())
  referenceId    String   @unique @default(uuid()) @map("reference_id")
  paymentId      Int      @unique @map("payment_id")
  userId         Int      @map("user_id")
  professionalId Int      @map("professional_id")
  mode           TipMode
  percentage     Decimal? @db.Decimal(5, 2)
  amount         Decimal  @db.Decimal(10, 2)
  currencyCode   String   @map("currency_code") @db.VarChar(3)

  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")
  lastChangedAt   DateTime? @default(now()) @map("last_changed_at")
  lastChangedBy   String?   @map("last_changed_by")
  changedReason   String?   @map("changed_reason")
  checksum        String?   @map("checksum")
  changeSignature String?   @map("change_signature")

  payment      Payments      @relation(fields: [paymentId], references: [id])
  users        Users         @relation(fields: [userId], references: [id])
  professional Professionals @relation(fields: [professionalId], references: [id])
  currency     Currency      @relation(fields: [currencyCode], references: [alphaCode])

  @@index([professionalId])
  @@map("tips")
}

